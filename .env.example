API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/buildright
# Free MongoDB Atlas (cloud) — paste the SRV URI from Atlas → Connect → Drivers:
# Include the database name buildright in the path, and URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/buildright?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional. Leave unset to use the procedural geometry service.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=20000

# Used only by npm run seed
SEED_ADMIN_EMAIL=admin@buildright.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
