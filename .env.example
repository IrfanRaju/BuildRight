API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Required. Local MongoDB (default for development):
MONGODB_URI=mongodb://127.0.0.1:27017/buildright
# Or MongoDB Atlas free cluster (URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/buildright?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional image hosting. If unset, uploads are stored under /uploads (local disk).
# On Vercel, Cloudinary is required (local disk is ephemeral).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=buildright

# Vercel project env (Production): set MONGODB_URI, JWT_SECRET (24+ chars),
# WEB_ORIGIN=https://YOUR_PROJECT.vercel.app, and Cloudinary keys.
# Local stays: npm run dev:full (Vite + Express). Deploy: vercel --prod

# Optional. Leave unset to use the procedural geometry service.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=20000

# Optional concept-image generation for repair previews
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-2
# IMAGE_BASE_URL=https://api.openai.com/v1

# Used only by npm run seed
SEED_ADMIN_EMAIL=admin@buildright.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
SEED_SUPPLIER_EMAIL=supplier@buildright.local
SEED_SUPPLIER_PASSWORD=ChangeMe-Supplier-2026
SEED_PROVIDER_EMAIL=provider@buildright.local
SEED_PROVIDER_PASSWORD=ChangeMe-Provider-2026
